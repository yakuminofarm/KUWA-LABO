{
  "name": "kuwa-labo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_PUBLIC_KUWA_TARGET=web next dev",
    "build": "NEXT_PUBLIC_KUWA_TARGET=web next build",
    "start": "next start",
    "lint": "eslint",
    "artifact": "NEXT_PUBLIC_KUWA_TARGET=web next build && node scripts/build-artifact.mjs",
    "build:native": "NEXT_PUBLIC_KUWA_TARGET=native next build",
    "sync:native": "npm run build:native && cap sync",
    "ios": "npm run sync:native && cap open ios",
    "android": "npm run sync:native && cap open android",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/local-notifications": "^8.3.1",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
